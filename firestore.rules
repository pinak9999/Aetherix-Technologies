rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'davepinak0@gmail.com'
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      );
      // Admins can update roles
      allow update: if isAdmin() && isValidUser(incoming());
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.role in ['admin', 'user'];
    }

    // --- Admins List ---
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Managed via console or bootstrap
    }

    // --- Contacts ---
    match /contacts/{contactId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isValidId(contactId) && isValidContact(incoming());
    }

    function isValidContact(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.message is string && data.message.size() <= 5000 &&
             data.createdAt == request.time;
    }

    // --- Newsletter ---
    match /newsletterSubscribers/{subId} {
      allow list: if isAdmin();
      allow create: if isValidId(subId) && isValidSubscriber(incoming());
    }

    function isValidSubscriber(data) {
      return data.email is string && data.email.size() <= 200 &&
             data.subscribedAt == request.time;
    }

    // --- Blog Posts ---
    match /blogPosts/{postId} {
      allow list: if isAdmin() || (resource.data.published == true);
      allow get: if isAdmin() || (resource.data.published == true);
      allow create: if isAdmin() && isValidBlog(incoming());
      allow update: if isAdmin() && isValidBlog(incoming());
      allow delete: if isAdmin();
    }

    function isValidBlog(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 250 &&
             data.content is string && data.content.size() <= 50000 &&
             data.published is bool;
    }

    // --- Demo Bookings ---
    match /demoBookings/{bookingId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
    }

    function isValidBooking(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt == request.time;
    }

    // --- Career Applications ---
    match /careerApplications/{appId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(appId) && isValidApplication(incoming());
    }

    function isValidApplication(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.appliedAt == request.time;
    }
  }
}
